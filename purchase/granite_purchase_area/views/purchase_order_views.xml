<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_order_form_inherit_granite_area" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.granite.area</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='product_id']"
                   position="after">
                <field name="length" string="Length (m)" optional="show"/>
                <field name="width" string="Width (m)" optional="show"/>
                <field name="area_m2" string="Area (m²)" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
