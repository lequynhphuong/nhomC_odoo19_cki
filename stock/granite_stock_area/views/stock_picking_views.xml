<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_move_line_operation_tree_inherit_granite_dimensions" model="ir.ui.view">
        <field name="name">stock.move.line.operations.list.inherit.granite.dimensions</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_id']" position="after">
                <field name="length" string="Length (m)" optional="show"/>
                <field name="width" string="Width (m)" optional="show"/>
                <field name="area_m2" string="Area (m²)" readonly="1" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
