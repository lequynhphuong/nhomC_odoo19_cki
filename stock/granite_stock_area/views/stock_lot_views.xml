<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_stock_lot_form_inherit_granite_dimensions" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.granite.dimensions</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main_group']" position="after">
                <notebook>
                    <page string="Dimensions">
                        <group>
                            <field name="supplier_id"/>
                            <field name="length"/>
                            <field name="width"/>
                            <field name="area_m2" readonly="1"/>
                        </group>
                    </page>
                </notebook>
            </xpath>
        </field>
    </record>
</odoo>
